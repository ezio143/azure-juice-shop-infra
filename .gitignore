# Terraform working directories
.terraform/

# Terraform state and backups (may contain sensitive data)
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files intended for local use
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
plan.out

# CLI configuration and local provider cache
.terraformrc
terraform.rc
*.hcl.backup